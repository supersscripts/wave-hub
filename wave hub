	[Enum.KeyCode.ButtonSelect] = true, [Enum.KeyCode.ButtonStart] = true,
}

local PRETTY_KEYS = {
	RightControl = "RIGHT CTRL", LeftControl = "LEFT CTRL",
	RightShift = "RIGHT SHIFT", LeftShift = "LEFT SHIFT",
	RightAlt = "RIGHT ALT", LeftAlt = "LEFT ALT",
	DPadRight = "RIGHT DPAD", DPadLeft = "LEFT DPAD",
	DPadUp = "UP DPAD", DPadDown = "DOWN DPAD",
}

keyName = function(keyCode)
	if not keyCode then return "NONE" end
	if PRETTY_KEYS[keyCode.Name] then return PRETTY_KEYS[keyCode.Name] end
	if GAMEPAD_KEYS[keyCode] then
		local n = keyCode.Name:gsub("^Button", "")
		return n:upper()
	end
	return keyCode.Name:upper()
end

updateHideLabel = function()
	hideLabel.Text = keyName(CONFIG.ToggleKey) .. " / " .. keyName(CONFIG.ToggleKeyPad) .. " TO HIDE"
