local function makeKeybindRow(parent, y, opts)
	local card = rowCard(parent, y, 52, false)
	rowText(card, opts.Title, opts.Hint, 190)

	local bindButton = create("TextLabel", {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -14, 0.5, 0),
		Size = UDim2.fromOffset(124, 28),
		BackgroundColor3 = THEME.Off,
		Font = Enum.Font.GothamBold,
		Text = "NONE",
		TextColor3 = THEME.Text,
		TextSize = 12,
		ZIndex = 6,
		Parent = card,
	}, { corner(UDim.new(0, 8)) })
	local bindStroke = stroke(THEME.Accent, 1, 0.6)
	bindStroke.Parent = bindButton

	local clearButton = create("TextLabel", {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -14 - 124 - 6, 0.5, 0),
		Size = UDim2.fromOffset(28, 28),
		BackgroundColor3 = THEME.Danger,
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamBlack,
		Text = "X",
		TextColor3 = THEME.Foam,
		TextTransparency = 1,
		TextSize = 12,
		Visible = false,
		ZIndex = 6,
		Parent = card,
	}, { corner(UDim.new(0, 8)) })

	local isListening = false
	local pulse

	local function showClear(on)
		if not opts.AllowClear then return end
		if on then
			clearButton.Visible = true
			tween(clearButton, TI_FAST, { BackgroundTransparency = 0, TextTransparency = 0 })
		else
			tween(clearButton, TI_FAST, { BackgroundTransparency = 1, TextTransparency = 1 })
			task.delay(0.2, function()
				if not isListening then clearButton.Visible = false end
			end)
		end
	end

	local function refresh()
		isListening = false
		if pulse then pulse:Cancel() pulse = nil end
		bindStroke.Transparency = 0.6
		bindButton.Text = keyName(opts.Get())
		tween(bindButton, TI_FAST, { BackgroundColor3 = THEME.Off, TextColor3 = THEME.Text })
		showClear(false)
	end
	refresh()

	onClick(bindButton, function()
		if destroyed then return end
		if listening then listening.Cancel() end
		isListening = true

		bindButton.Text = "PRESS A KEY"
		tween(bindButton, TI_FAST, { BackgroundColor3 = THEME.Accent, TextColor3 = THEME.Abyss })
		bindStroke.Transparency = 0
		pulse = tween(bindStroke, TweenInfo.new(0.5, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true), { Transparency = 0.7 })
		showClear(true)

		listening = {
			AllowClear = opts.AllowClear,
			Validate = opts.Validate or function() return true end,
			Capture = function(keyCode)
				listening = nil
				opts.Set(keyCode)
				refresh()
			end,
			Cancel = function()
				listening = nil
				refresh()
			end,
		}
	end)

	onClick(clearButton, function()
		if isListening and listening then
			listening.Capture(nil)
		end
	end)

	return refresh
end

