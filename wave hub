-- Features

-- Auto Sticky

local HeadHop = {}
do
	local settings = {
		PullStrength = 0.5,
		Stickiness = 1,
	}

	local CFG = {

		SearchRadius = 7,
		MaxBelow = 5,
		MaxAbove = 6,
		MaxPullSpeed = 60,
		PullForce = 15000,
		FastArrive = 0.7,

		StickForce = 60000,
		CenterPull = 2,
		MaxHeadOffset = 0.75, -- furthest from the center of their head it will hold you
		MoveThreshold = 0.1,
	}

	local stickyOn = false
	local running = false
	local conns = {}
	local charConns = {}

	local character, humanoid, root
	local attach, pullMover, stickMover

	local pullTarget = nil
	local stickModel = nil
	local stickOffset = nil
	local lastContact = 0
	local lastTheirYaw = nil
	local jumpedOff = false
	local lastJumpRequest = 0
	local stickArmed = false -- only true after a jump you actually pressed

	local rayParams = RaycastParams.new()
	rayParams.FilterType = Enum.RaycastFilterType.Exclude

	local function isAlive(model)
		local hum = model and model:FindFirstChildOfClass("Humanoid")
		return hum and hum.Health > 0
	end

	local function legLength()
		local extra = (humanoid.RigType == Enum.HumanoidRigType.R6) and 2 or 0
		return root.Size.Y / 2 + humanoid.HipHeight + extra
	end

	local function findBestHead()
		if not root then return nil end
		local best, bestDist = nil, math.huge
		for _, other in ipairs(Players:GetPlayers()) do
			local char = other.Character
			if other ~= player and char and isAlive(char) then
				local head = char:FindFirstChild("Head")
				if head then
					local offset = head.Position - root.Position
					local flatDist = Vector3.new(offset.X, 0, offset.Z).Magnitude
					if flatDist <= CFG.SearchRadius
						and offset.Y >= -CFG.MaxBelow
						and offset.Y <= CFG.MaxAbove
						and flatDist < bestDist then
						best, bestDist = head, flatDist
					end
				end
			end
		end
		return best
	end

	-- walk up through helmets / gear models until we reach the actual player character
	local function characterFromPart(part)
		local model = part and part:FindFirstAncestorOfClass("Model")
		while model do
			if Players:GetPlayerFromCharacter(model) then return model end
			model = model:FindFirstAncestorOfClass("Model")
		end
		return nil
	end

	local function getStandingCharacter()
		local reach = legLength() + 1.5
		rayParams.FilterDescendantsInstances = { character }
		local dir = Vector3.new(0, -reach, 0)
		local result = workspace:Spherecast(root.Position, 1, dir, rayParams)
			or workspace:Raycast(root.Position, dir, rayParams)
		if result then
			local model = characterFromPart(result.Instance)
			if model and model ~= character and isAlive(model) then
				return model
			end
		end

		-- backup: is someone's head right under your feet? (works even if the game hides heads from raycasts)
		for _, other in ipairs(Players:GetPlayers()) do
			local char = other.Character
			if other ~= player and char and isAlive(char) then
				local head = char:FindFirstChild("Head")
				if head then
					local off = root.Position - head.Position
					local flat = Vector3.new(off.X, 0, off.Z).Magnitude
					local above = off.Y
					if flat < 2.5 and above > 0 and above < reach + head.Size.Y then
						return char
					end
				end
			end
		end
		return nil
	end

	local function headYawCFrame(model)
		local head = model:FindFirstChild("Head")
		local theirRoot = model:FindFirstChild("HumanoidRootPart") or head
		if not head then return nil end
		local look = theirRoot.CFrame.LookVector
		look = Vector3.new(look.X, 0, look.Z)
		if look.Magnitude < 0.01 then look = Vector3.new(0, 0, -1) end
		-- no turning: your spot is kept in world directions, so you don't spin when they turn
		return CFrame.new(head.Position), math.atan2(-look.X, -look.Z)
	end

	local function releaseStick()
		stickModel, stickOffset, lastTheirYaw = nil, nil, nil
		if stickMover then stickMover.Enabled = false end
	end

	local function cleanupCharacter()
		for _, c in ipairs(charConns) do c:Disconnect() end
		table.clear(charConns)
		pullTarget = nil
		releaseStick()
		if pullMover then pullMover:Destroy() end
		if stickMover then stickMover:Destroy() end
		if attach then attach:Destroy() end
		attach, pullMover, stickMover = nil, nil, nil
		character, humanoid, root = nil, nil, nil
		jumpedOff = false
		stickArmed = false
	end

	local function onCharacterAdded(char)
		cleanupCharacter()
		local hum = char:WaitForChild("Humanoid", 10)
		local hrp = char:WaitForChild("HumanoidRootPart", 10)

		if not running or not hum or not hrp or player.Character ~= char then return end

		character, humanoid, root = char, hum, hrp

		attach = Instance.new("Attachment")
		attach.Name = "WaveHeadHopAttachment"
		attach.Parent = root

		pullMover = Instance.new("LinearVelocity")
		pullMover.Name = "WaveHeadHopPull"
		pullMover.Attachment0 = attach
		pullMover.RelativeTo = Enum.ActuatorRelativeTo.World
		pullMover.VelocityConstraintMode = Enum.VelocityConstraintMode.Plane
		pullMover.PrimaryTangentAxis = Vector3.new(1, 0, 0)
		pullMover.SecondaryTangentAxis = Vector3.new(0, 0, 1)
		pullMover.ForceLimitMode = Enum.ForceLimitMode.Magnitude
		pullMover.Enabled = false
		pullMover.Parent = root

		stickMover = Instance.new("AlignPosition")
		stickMover.Name = "WaveHeadHopStick"
		stickMover.Mode = Enum.PositionAlignmentMode.OneAttachment
		stickMover.Attachment0 = attach
		stickMover.ForceLimitMode = Enum.ForceLimitMode.PerAxis
		stickMover.Responsiveness = 200
		stickMover.MaxVelocity = math.huge
		stickMover.ApplyAtCenterOfMass = true
		stickMover.Enabled = false
		stickMover.Parent = root

		table.insert(charConns, humanoid.StateChanged:Connect(function(_, newState)
			if newState == Enum.HumanoidStateType.Jumping then
				-- only count jumps you actually pressed (not pushes / physics)
				if os.clock() - lastJumpRequest < 0.5 then
					jumpedOff = true
					stickArmed = true
					if stickyOn then
						pullTarget = findBestHead()
					end
				end
			elseif newState == Enum.HumanoidStateType.Landed
				or newState == Enum.HumanoidStateType.Running
				or newState == Enum.HumanoidStateType.Dead then
				pullTarget = nil
			end
		end))
	end

	local function updatePull(airborne, isMoving, moveDir)
		if not (airborne and pullTarget and pullTarget.Parent and isAlive(pullTarget.Parent)
			and settings.PullStrength > 0) then
			pullMover.Enabled = false
			return
		end

		local head = pullTarget
		local vel = root.AssemblyLinearVelocity
		local g = workspace.Gravity

		local standY = head.Position.Y + head.Size.Y / 2 + legLength()
		local dy = standY - root.Position.Y

		local disc = vel.Y * vel.Y - 2 * g * dy
		local t
		if disc >= 0 then
			t = (vel.Y + math.sqrt(disc)) / g
		else
			t = math.max(vel.Y / g, 0) + 0.1
		end
		t = t * (1 - CFG.FastArrive * settings.PullStrength)
		t = math.max(t, 0.05)

		local headVel = head.AssemblyLinearVelocity
		local aim = head.Position + Vector3.new(headVel.X, 0, headVel.Z) * t
		local flat = Vector3.new(aim.X - root.Position.X, 0, aim.Z - root.Position.Z)

		local needed = flat / t + Vector3.new(headVel.X, 0, headVel.Z) * 0.5
		if needed.Magnitude > CFG.MaxPullSpeed then
			needed = needed.Unit * CFG.MaxPullSpeed
		end

		pullMover.PlaneVelocity = Vector2.new(needed.X, needed.Z)
		pullMover.MaxForce = root.AssemblyMass * CFG.PullForce * settings.PullStrength
		pullMover.Enabled = true
	end

	local function updateStick(dt, isMoving)
		if settings.Stickiness <= 0 or jumpedOff or not stickArmed then
			releaseStick()
			return
		end

		local now = os.clock()
		local under = getStandingCharacter()

		if under then
			if under ~= stickModel then
				releaseStick()
				stickModel = under
			end
			lastContact = now
		elseif stickModel then
			-- infinite grace: never times out, only lets go if they die
			if not isAlive(stickModel) then
				releaseStick()
				return
			end
		else
			return
		end

		local yawCF, theirYaw = headYawCFrame(stickModel)
		if not yawCF then
			releaseStick()
			return
		end

		if isMoving then
			-- you're walking: don't hold you in place
			stickMover.Enabled = false
			if not under then
				-- walked off their head on purpose: let go
				releaseStick()
				stickArmed = false
				return
			end
			-- still on their head: remember your new spot so it holds you there when you stop
			local rel = yawCF:PointToObjectSpace(root.Position)
			stickOffset = Vector3.new(rel.X, 0, rel.Z)
			lastTheirYaw = theirYaw
			return
		end

		if not stickOffset then
			local rel = yawCF:PointToObjectSpace(root.Position)
			stickOffset = Vector3.new(rel.X, 0, rel.Z)
		end

		stickOffset = stickOffset * (1 - math.clamp(dt * CFG.CenterPull * settings.Stickiness, 0, 1))
		-- keep you over their HEAD, not their shoulder/torso (eased in, not snapped)
		if stickOffset.Magnitude > CFG.MaxHeadOffset then
			local newMag = math.max(CFG.MaxHeadOffset, stickOffset.Magnitude - 8 * dt)
			stickOffset = stickOffset.Unit * newMag
		end

		-- carry you by moving your position with their head, and give you exactly their
		-- sideways speed, so relative to their head you're standing still (not walking)
		stickMover.Enabled = false
		local target = yawCF:PointToWorldSpace(stickOffset)
		local cur = root.Position
		local goal = Vector3.new(target.X, cur.Y, target.Z)
		local newPos = cur:Lerp(goal, math.clamp(settings.Stickiness, 0, 1))
		root.CFrame = CFrame.new(newPos) * root.CFrame.Rotation
		local theirHead = stickModel:FindFirstChild("Head")
		local tv = theirHead and theirHead.AssemblyLinearVelocity or Vector3.zero
		local v = root.AssemblyLinearVelocity
		root.AssemblyLinearVelocity = Vector3.new(tv.X, v.Y, tv.Z)

		lastTheirYaw = theirYaw
	end

	local function step(dt)
		if not (character and humanoid and root and pullMover and stickMover and humanoid.Health > 0) then
			return
		end

		local moveDir = humanoid.MoveDirection
		local isMoving = moveDir.Magnitude > CFG.MoveThreshold
		local state = humanoid:GetState()
		local airborne = state == Enum.HumanoidStateType.Jumping or state == Enum.HumanoidStateType.Freefall

		if stickyOn then
			updatePull(airborne, isMoving, moveDir)
			updateStick(dt, isMoving)
		else
			pullTarget = nil
			pullMover.Enabled = false
			releaseStick()
		end

		-- back on normal ground (not a head): need a new jump before it sticks again
		if stickArmed and not airborne and not stickModel and not getStandingCharacter()
			and os.clock() - lastJumpRequest > 0.5 then
			stickArmed = false
		end

		-- count as landed once you're on the ground, or on someone's head and no longer rising
		-- (Roblox often still says "falling" while you're standing on a head)
		if jumpedOff and (not airborne
			or (getStandingCharacter() and root.AssemblyLinearVelocity.Y <= 0.5)) then
			jumpedOff = false
		end
	end

	local function start()
		if running then return end
		running = true
		table.insert(conns, player.CharacterAdded:Connect(onCharacterAdded))
		table.insert(conns, RunService.Heartbeat:Connect(step))
		table.insert(conns, UserInputService.JumpRequest:Connect(function()
			lastJumpRequest = os.clock()
			stickArmed = true
		end))
		if player.Character then
			task.spawn(onCharacterAdded, player.Character)
		end
	end

	local function stop()
		running = false
		for _, c in ipairs(conns) do c:Disconnect() end
		table.clear(conns)
		cleanupCharacter()
	end

	local function refresh()
		if stickyOn then start() else stop() end
	end

	function HeadHop.EnableSticky()
		stickyOn = true
		refresh()
	end
	function HeadHop.DisableSticky()
		stickyOn = false
		pullTarget = nil
		if pullMover then pullMover.Enabled = false end
		releaseStick()
		refresh()
	end

	function HeadHop.SetPullStrength(v) settings.PullStrength = v end
	function HeadHop.SetStickiness(v) settings.Stickiness = v end
	HeadHop.Defaults = {
		PullStrength = settings.PullStrength,
		Stickiness = settings.Stickiness,
	}
end

-- Loop
local SpeedLoop = {}
do
	local DEFAULT_WALKSPEED = 21
	local customSpeed = 21

	local active = false
	local conns = {}
	local humConn = nil
	local humanoid = nil

	local function enforce()
		if active and humanoid and humanoid.Parent and humanoid.WalkSpeed ~= customSpeed then
			humanoid.WalkSpeed = customSpeed
		end
	end

	local function setup(char)
		if humConn then humConn:Disconnect() humConn = nil end
		local hum = char:WaitForChild("Humanoid", 10)
		if not active or not hum or player.Character ~= char then return end
		humanoid = hum

		humConn = humanoid:GetPropertyChangedSignal("WalkSpeed"):Connect(enforce)
		enforce()
	end

	function SpeedLoop.Enable()
		if active then return end
		active = true
		table.insert(conns, player.CharacterAdded:Connect(setup))
		table.insert(conns, RunService.Stepped:Connect(enforce))
		table.insert(conns, RunService.Heartbeat:Connect(enforce))
		table.insert(conns, RunService.RenderStepped:Connect(enforce))
		if player.Character then
			task.spawn(setup, player.Character)
		end
	end

	function SpeedLoop.Disable()
		active = false
		for _, c in ipairs(conns) do c:Disconnect() end
		table.clear(conns)
		if humConn then humConn:Disconnect() humConn = nil end
		if humanoid and humanoid.Parent then
			humanoid.WalkSpeed = DEFAULT_WALKSPEED
		end
		humanoid = nil
	end

	function SpeedLoop.SetSpeed(v)
		customSpeed = v
		enforce()
	end

	SpeedLoop.Defaults = { Speed = customSpeed }
end

-- OG Catch Animation

local CatchAnim = {}
do

	local BALL_NAMES = {
		football = true, ball = true, footballmain = true, pigskin = true,
	}

	local active = false
	local conns = {}
	local tracked = {}
	local hidden = {}

	local function myCharacter()
		return player.Character or workspace:FindFirstChild(player.Name)
	end

	local function isMine(inst)
		local char = myCharacter()
		return char ~= nil and (inst == char or inst:IsDescendantOf(char))
	end

	local function isFootball(inst)
		local cur = inst
		while cur and cur ~= workspace and cur ~= game do
			if BALL_NAMES[cur.Name:lower()] then return true end
			cur = cur.Parent
		end
		return false
	end

	local function shouldHide(h)
		for _, target in ipairs({ h.Parent, h.Adornee }) do
			if target and (isMine(target) or isFootball(target)) then
				return true
			end
		end
		return false
	end

	local function hide(h)
		if hidden[h] then

			h.Enabled = false
			return
		end
		hidden[h] = { Enabled = h.Enabled, Fill = h.FillTransparency, Outline = h.OutlineTransparency }
		h.Enabled = false
		h.FillTransparency = 1
		h.OutlineTransparency = 1
	end

	local function unhide(h)
		local orig = hidden[h]
		if not orig then return end
		hidden[h] = nil
		if h.Parent then
			h.FillTransparency = orig.Fill
			h.OutlineTransparency = orig.Outline
			h.Enabled = orig.Enabled
		end
	end

	local function evaluate(h)
		if not active or not h.Parent then return end
		if shouldHide(h) then hide(h) else unhide(h) end
	end

	local function track(h)
		if tracked[h] then return end
		tracked[h] = {

			h:GetPropertyChangedSignal("Adornee"):Connect(function() evaluate(h) end),
			h:GetPropertyChangedSignal("Enabled"):Connect(function()
				if active and hidden[h] and h.Enabled then h.Enabled = false end
			end),
			h.AncestryChanged:Connect(function() task.defer(evaluate, h) end),
		}
		evaluate(h)
		task.defer(evaluate, h)
	end

	local function watch(root)
		for _, obj in ipairs(root:GetDescendants()) do
			if obj:IsA("Highlight") then track(obj) end
		end
		table.insert(conns, root.DescendantAdded:Connect(function(obj)
			if obj:IsA("Highlight") then track(obj) end
		end))
	end

	function CatchAnim.Enable()
		if active then return end
		active = true
		watch(workspace)
		watch(player:WaitForChild("PlayerGui"))

		task.spawn(function()
			while active do
				for h in pairs(tracked) do
					evaluate(h)
				end
				task.wait(0.5)
			end
		end)
	end

	function CatchAnim.Disable()
		active = false
		for _, c in ipairs(conns) do c:Disconnect() end
		table.clear(conns)
		for h, list in pairs(tracked) do
			for _, c in ipairs(list) do c:Disconnect() end
		end
		table.clear(tracked)
		for h in pairs(hidden) do
			unhide(h)
		end
		table.clear(hidden)
	end
end

-- Ball TP

local BallTP = {}
do

	local Players          = game:GetService("Players")
	local RunService       = game:GetService("RunService")
	local UserInputService = game:GetService("UserInputService")
	local Workspace        = game:GetService("Workspace")
	local CoreGui          = game:GetService("CoreGui")

	local plr = Players.LocalPlayer
	if not plr then
		repeat task.wait(0.1) until Players.LocalPlayer
		plr = Players.LocalPlayer
	end

	local S = {
		enabled  = false,
		range    = 60,
		strength = 40,
		snapDist = 20,
		maxSpeed = 80,
	}

	local char, root, hum
	local ball, lastScan = nil, 0
	local catchParts = {}
	local savedCollide = nil
	local lastHandRefresh = 0
	local lastOwnedBall = nil

	local fireTouch = type(firetouchinterest) == "function" and firetouchinterest or nil
	if type(setsimulationradius) == "function" then
		pcall(setsimulationradius, 1e6, 1e6)
	end

	local BALL_GROUP = "BallTPPull"
	do
		pcall(function()
			local PS = game:GetService("PhysicsService")
			local ok, groups = pcall(function() return PS:GetRegisteredCollisionGroups() end)
			local exists = false
			if ok and groups then
				for _, g in ipairs(groups) do
					if g.name == BALL_GROUP then exists = true; break end
				end
			end
			if not exists then PS:RegisterCollisionGroup(BALL_GROUP) end
			PS:CollisionGroupSetCollidable(BALL_GROUP, "Default", false)
			PS:CollisionGroupSetCollidable(BALL_GROUP, BALL_GROUP, false)
		end)
	end

	local function setBallGroup(b, useGroup)
		if not b then return end
		pcall(function()
			if useGroup then
				if b.CollisionGroup ~= BALL_GROUP then b.CollisionGroup = BALL_GROUP end
			else
				if b.CollisionGroup == BALL_GROUP then b.CollisionGroup = "Default" end
			end
		end)
	end

	local ballCache = {}
	local ballCacheDirty = true

	local function isBall(v)
		if not v or not v:IsA("BasePart") then return false end
		local n = string.lower(v.Name)
		if string.find(n, "baseball", 1, true) then return false end
		return n == "football" or n == "footballmain" or n == "pigskin" or n == "handle"
			or string.find(n, "football", 1, true) ~= nil
			or string.find(n, "pigskin", 1, true) ~= nil
	end

	local function heldOther(b)
		if not b or not b.Parent then return false end
		for _, c in ipairs(b:GetChildren()) do
			if c:IsA("Weld") or c:IsA("WeldConstraint") or c:IsA("Motor6D") then
				local other = c.Part0 == b and c.Part1 or c.Part0
				if other then
					local m = other:FindFirstAncestorOfClass("Model")
					if m and m ~= char and m:FindFirstChildOfClass("Humanoid") then
						return true
					end
				end
			end
		end
		local m = b:FindFirstAncestorOfClass("Model")
		if m and m ~= char and m:FindFirstChildOfClass("Humanoid") then return true end
		return false
	end

	local function heldUs(b)
		if not b or not char then return false end
		if b:IsDescendantOf(char) then return true end
		for _, t in ipairs(char:GetChildren()) do
			if t:IsA("Tool") and b:IsDescendantOf(t) then return true end
		end
		return false
	end

	local lastFullScan = 0

	-- strict check for the deep search, so random map parts never count as the ball
	local function isRealBall(v)
		if not v:IsA("BasePart") then return false end
		local n = string.lower(v.Name)
		if n == "football" or n == "footballmain" or n == "pigskin" then return true end
		if n == "handle" and v.Parent then
			return string.find(string.lower(v.Parent.Name), "football", 1, true) ~= nil
		end
		return false
	end

	local function rebuildCache()
		-- only adds; destroyed balls are dropped in findBall, live-detected balls are kept
		-- same search as the original script
		for _, v in ipairs(Workspace:GetChildren()) do
			if isBall(v) then
				ballCache[v] = true
			elseif v:IsA("Model") or v:IsA("Tool") then
				for _, c in ipairs(v:GetChildren()) do
					if isBall(c) then ballCache[c] = true end
				end
			end
		end
		-- plus real footballs anywhere deeper in the map
		for _, v in ipairs(Workspace:GetDescendants()) do
			if isRealBall(v) then ballCache[v] = true end
		end
		ballCacheDirty = false
		lastFullScan = tick()
	end

	local function registerMaybe(c)
		if isBall(c) then
			ballCache[c] = true
		elseif c:IsA("Model") or c:IsA("Tool") then
			for _, cc in ipairs(c:GetChildren()) do
				if isBall(cc) then ballCache[cc] = true end
			end
		end
	end

	Workspace.ChildAdded:Connect(registerMaybe)
	Workspace.ChildRemoved:Connect(function(c) ballCache[c] = nil end)
	Workspace.DescendantAdded:Connect(function(d)
		if isBall(d) then ballCache[d] = true end
	end)

	local function usable(p)
		return p and p.Parent and not heldOther(p) and not heldUs(p)
	end

	local function findBall()
		if ball and not ball.Parent then
			ballCache[ball] = nil
			ball = nil
		end

		-- keep the current ball briefly, but re-pick the nearest one 5 times a second
		-- so it never stays locked onto a far-away ball / prop while a closer one is on the floor
		local current = usable(ball) and ball or nil
		if tick() - lastScan < (current and 0.2 or 0.05) then return current end
		lastScan = tick()

		if ballCacheDirty then rebuildCache() end

		local origin = root and root.Position or Vector3.zero
		local function nearest()
			local best, bestD = nil, math.huge
			for p in pairs(ballCache) do
				if usable(p) then
					local d = (p.Position - origin).Magnitude
					if d < bestD then bestD = d; best = p end
				elseif not p.Parent then
					ballCache[p] = nil
				end
			end
			return best, bestD
		end

		local best, bestD = nearest()

		-- nothing usable in range: search the whole workspace again, at most every half second
		if (not best or bestD > S.range) and tick() - lastFullScan > 0.5 then
			rebuildCache()
			best, bestD = nearest()
		end

		if ball and ball ~= best then setBallGroup(ball, false) end
		ball = best
		return ball
	end

	local function refreshParts()
		catchParts = {}
		if not char then return end
		for _, n in ipairs({
			"RightHand","LeftHand","RightLowerArm","LeftLowerArm",
			"Right Arm","Left Arm","RightUpperArm","LeftUpperArm",
			"HumanoidRootPart","UpperTorso","LowerTorso","Torso","Head"
		}) do
			local p = char:FindFirstChild(n)
			if p and p:IsA("BasePart") then table.insert(catchParts, p) end
		end
	end

	local function touch(b)
		if not fireTouch or not b or not b.Parent then return end
		for _, p in ipairs(catchParts) do
			if p and p.Parent then
				pcall(fireTouch, p, b, 0)
				pcall(fireTouch, p, b, 1)
			end
		end
	end

	local function hrpPos()
		if not root or not root.Parent then return nil end
		return root.Position + root.CFrame.LookVector * 1.3 + Vector3.new(0, 1.1, 0)
	end

	local function softCollide(b)
		if not b then return end
		setBallGroup(b, true)
		if savedCollide == nil then
			pcall(function() savedCollide = b.CanCollide end)
		end
		pcall(function() b.CanCollide = false end)
	end

	local function restoreCollide(b)
		setBallGroup(b, false)
		if b and savedCollide ~= nil then
			pcall(function() b.CanCollide = savedCollide end)
		end
		savedCollide = nil
	end

	local function takeOwnership(b)
		if not b or b == lastOwnedBall then return end
		lastOwnedBall = b
		pcall(function() b:SetNetworkOwner(plr) end)
	end

	local function snapVel(b, target)
		local delta = target - b.Position
		local dist = delta.Magnitude
		if dist < 0.1 then
			pcall(function()
				b.AssemblyLinearVelocity = Vector3.zero
				b.AssemblyAngularVelocity = Vector3.zero
			end)
			touch(b)
			return
		end

		softCollide(b)
		local dir = delta.Unit
		local speed = math.clamp(dist * 25, 10, 45)

		pcall(function()
			local v = dir * speed
			v = Vector3.new(v.X, math.clamp(v.Y, -15, 15), v.Z)
			b.AssemblyLinearVelocity = v
			b.AssemblyAngularVelocity = Vector3.zero
		end)
		touch(b)
	end

	local function pullVel(b, target, dt)
		local delta = target - b.Position
		local dist = delta.Magnitude
		if dist < 0.1 then
			snapVel(b, target)
			return
		end

		softCollide(b)
		local dir = delta.Unit
		local speed = math.min(S.maxSpeed, 30 + dist * 20) * (S.strength / 12)
		local tv = dir * speed

		pcall(function()
			local cur = b.AssemblyLinearVelocity
			cur = Vector3.new(cur.X, cur.Y * 0.5, cur.Z)
			local alpha = math.clamp(dt * 35, 0, 0.85)
			local newVel = cur:Lerp(tv, alpha)
			if newVel.Magnitude > S.maxSpeed then
				newVel = newVel.Unit * S.maxSpeed
			end
			b.AssemblyLinearVelocity = newVel
			b.AssemblyAngularVelocity = b.AssemblyAngularVelocity * 0.1
		end)
		if dist < 7 then touch(b) end
	end

	local function bind(c)
		char = c
		root = c:WaitForChild("HumanoidRootPart", 8)
		hum  = c:WaitForChild("Humanoid", 8)
		if ball then restoreCollide(ball) end
		ball = nil
		savedCollide = nil
		lastOwnedBall = nil
		ballCacheDirty = true
		task.wait(0.05)
		refreshParts()
	end

	if plr.Character then task.spawn(bind, plr.Character) end
	plr.CharacterAdded:Connect(function(c) task.spawn(bind, c) end)
	plr.CharacterRemoving:Connect(function()
		if ball then restoreCollide(ball) end
		char, root, hum, ball = nil, nil, nil, nil
		catchParts = {}
		lastOwnedBall = nil
	end)

	RunService.Heartbeat:Connect(function(dt)
		if not S.enabled or not char or not root or not hum then return end
		if hum.Health <= 0 then return end

		local now = tick()
		if now - lastHandRefresh > 0.25 then
			lastHandRefresh = now
			if #catchParts == 0 or not catchParts[1].Parent then
				refreshParts()
			end
		end

		local b = findBall()
		if not b or not b.Parent or heldOther(b) or heldUs(b) then
			if ball then restoreCollide(ball) end
			return
		end

		local target = hrpPos()
		if not target then return end
		local dist = (b.Position - target).Magnitude
		if dist > S.range then
			restoreCollide(b)
			return
		end

		pcall(function()
			if b.Anchored then b.Anchored = false end
			if b.Massless then b.Massless = false end
		end)

		takeOwnership(b)

		if dist <= S.snapDist then
			snapVel(b, target)
		else
			pullVel(b, target, dt)
		end
	end)

	function BallTP.Enable()
		S.enabled = true
	end

	function BallTP.Disable()
		S.enabled = false
		if ball then restoreCollide(ball) end
	end
end

