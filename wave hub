	local box = create("TextBox", {
		Size = UDim2.new(1, -12, 1, 0),
		Position = UDim2.fromOffset(6, 0),
		BackgroundTransparency = 1,
		ClearTextOnFocus = false,
		Font = Enum.Font.GothamBold,
		Text = tostring(value),
		TextColor3 = THEME.Text,
		PlaceholderColor3 = THEME.SubText,
		TextSize = 13,
		ZIndex = 7,
		Parent = boxBg,
	})

	box.Focused:Connect(function()
		tween(boxStroke, TI_FAST, { Color = THEME.Aqua, Transparency = 0 })
	end)

	box.FocusLost:Connect(function()
		local raw = box.Text:gsub("[^%d%.%-]", "")
		local num = tonumber(raw)
		if num then
			num = math.clamp(num, def.Min or -math.huge, def.Max or math.huge)
			value = num
			box.Text = tostring(num)
			if def.OnChange then
				local ok, err = pcall(def.OnChange, num)
				if not ok then warn("[WAVE HUB] input error: " .. tostring(err)) end
			end
			tween(boxStroke, TI_FAST, { Color = THEME.Aqua })
		else
			box.Text = tostring(value)
			tween(boxStroke, TI_FAST, { Color = THEME.Danger, Transparency = 0 })
		end
		task.delay(0.7, function()
			if boxStroke.Parent then
				tween(boxStroke, TI_MED, { Color = THEME.Accent, Transparency = 0.6 })
			end
		end)
	end)

	if def.OnChange then pcall(def.OnChange, value) end

	local function setNumber(num)
		num = math.clamp(num, def.Min or -math.huge, def.Max or math.huge)
		value = num
		box.Text = tostring(num)
		if def.OnChange then pcall(def.OnChange, num) end
	end
	return setNumber, function() return value end
end

-- Slider
local TI_SLIDE = TweenInfo.new(0.08, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)

local function makeSlider(page, y, def)
	local card = create("Frame", {
		Position = UDim2.fromOffset(0, y),
		Size = UDim2.new(1, 0, 0, 62),
		BackgroundColor3 = THEME.Card,
