	}, { corner(UDim.new(0, 11)), stroke(THEME.Accent, 1, 0.75) })

	create("TextLabel", {
		Position = UDim2.fromOffset(16, 10),
		Size = UDim2.new(1, -90, 0, 18),
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamBold,
		Text = def.Name,
		TextColor3 = THEME.Text,
		TextSize = 13,
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 6,
		Parent = card,
	})
	local valueLabel = create("TextLabel", {
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -16, 0, 10),
		Size = UDim2.fromOffset(60, 18),
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamBlack,
		Text = "0%",
		TextColor3 = THEME.Aqua,
		TextSize = 13,
		TextXAlignment = Enum.TextXAlignment.Right,
		ZIndex = 6,
		Parent = card,
	})

	local track = create("TextLabel", {
		Active = true,
		Position = UDim2.new(0, 16, 0, 40),
		Size = UDim2.new(1, -32, 0, 8),
		BackgroundColor3 = THEME.Off,
		Text = "",
		ZIndex = 6,
		Parent = card,
	}, { corner(UDim.new(1, 0)) })

	local fill = create("Frame", {
		Size = UDim2.fromScale(0, 1),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BorderSizePixel = 0,
		ZIndex = 7,
		Parent = track,
	}, {
		corner(UDim.new(1, 0)),
		create("UIGradient", {
			Color = ColorSequence.new(THEME.Accent, THEME.Aqua),
		}),
	})

	local knob = create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0, 0.5),
		Size = UDim2.fromOffset(16, 16),
		BackgroundColor3 = THEME.Foam,
		ZIndex = 8,
		Parent = track,
	}, { corner(UDim.new(1, 0)), stroke(THEME.Accent, 1.5, 0.2) })

	local hasRange = def.Min ~= nil and def.Max ~= nil
	local function toActual(v)
		return hasRange and math.floor(def.Min + v * (def.Max - def.Min) + 0.5) or v
	end

	local function render(v)
		v = math.clamp(v, 0, 1)
		valueLabel.Text = hasRange and (toActual(v) .. (def.Suffix or "")) or (math.floor(v * 100 + 0.5) .. "%")
		tween(fill, TI_SLIDE, { Size = UDim2.fromScale(v, 1) })
		tween(knob, TI_SLIDE, { Position = UDim2.fromScale(v, 0.5) })
		return v
	end

	local current = def.Default
	local function setValue(v)
		if not hasRange then v = math.floor(math.clamp(v, 0, 1) * 100 + 0.5) / 100 end
		v = render(v)
		current = toActual(v)
		if def.OnChange then
			local ok, err = pcall(def.OnChange, toActual(v))
			if not ok then warn("[WAVE HUB] slider error: " .. tostring(err)) end
		end
	end

	local sliding = false
	local function setFromX(x)
		setValue((x - track.AbsolutePosition.X) / track.AbsoluteSize.X)
	end

	track.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			sliding = true
			setFromX(input.Position.X)
		end
	end)
	table.insert(connections, UserInputService.InputChanged:Connect(function(input)
		if sliding and (input.UserInputType == Enum.UserInputType.MouseMovement
			or input.UserInputType == Enum.UserInputType.Touch) then
			setFromX(input.Position.X)
		end
	end))
	table.insert(connections, UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			sliding = false
		end
	end))

	local function setActual(a, fire)
		render(hasRange and (a - def.Min) / (def.Max - def.Min) or a)
		current = a
		if fire and def.OnChange then pcall(def.OnChange, a) end
	end
	setActual(def.Default or (hasRange and def.Min) or 0.5)
	return setActual, function() return current end
end

