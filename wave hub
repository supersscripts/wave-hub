local function makeToggleRow(parent, y, def)
	local card, cardStroke = rowCard(parent, y, 52, true)
	rowText(card, def.Name, def.Hint, 90)

	local switch = create("Frame", {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -16, 0.5, 0),
		Size = UDim2.fromOffset(48, 24),
		BackgroundColor3 = THEME.Off,
		ZIndex = 6,
		Parent = card,
	}, { corner(UDim.new(1, 0)) })
	local knob = create("Frame", {
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 3, 0.5, 0),
		Size = UDim2.fromOffset(18, 18),
		BackgroundColor3 = THEME.Foam,
		ZIndex = 7,
		Parent = switch,
	}, { corner(UDim.new(1, 0)) })

	local state = def.Default and true or false

	local function render(info)
		tween(switch, info, { BackgroundColor3 = state and THEME.Accent or THEME.Off })
		tween(knob, info, { Position = state and UDim2.new(1, -21, 0.5, 0) or UDim2.new(0, 3, 0.5, 0) })
		tween(cardStroke, info, { Transparency = state and 0.3 or 0.75 })
	end
	render(TweenInfo.new(0))

	local function set(newState, silent)
		if destroyed or state == newState then return end
		state = newState
		render(TI_MED)
		if def.OnChange then
			local ok, err = pcall(def.OnChange, state)
			if not ok then warn("[WAVE HUB] " .. def.Name .. " error: " .. tostring(err)) end
		end
		if not silent then
			toast(def.Name .. (state and " ON" or " OFF"))
		end
	end

	card.MouseEnter:Connect(function()
		tween(card, TI_FAST, { BackgroundColor3 = THEME.CardHover })
	end)
	card.MouseLeave:Connect(function()
		tween(card, TI_FAST, { BackgroundColor3 = THEME.Card })
	end)
	onClick(card, function()
		set(not state)
	end)

	return set, function() return state end
end

