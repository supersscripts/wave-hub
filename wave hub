-- Save / Load Config
local HttpService = game:GetService("HttpService")
local settingsRefresh = { Menu = {} }

local function hasFiles()
	return typeof(writefile) == "function" and typeof(readfile) == "function" and typeof(isfile) == "function"
end

local function keyFromName(n)
	if type(n) ~= "string" then return nil end
	local ok, kc = pcall(function() return Enum.KeyCode[n] end)
	return ok and kc or nil
end

local loadingConfig = false

local function saveConfig(silent)
	if not hasFiles() then
		if not silent then toast("SAVING NEEDS AN EXECUTOR") end
		return
	end
	local data = {
		Notifications = uiSettings.Notifications,
		MenuKey = CONFIG.ToggleKey and CONFIG.ToggleKey.Name,
		MenuButton = CONFIG.ToggleKeyPad and CONFIG.ToggleKeyPad.Name,
		Keybinds = {},
		Values = {},
	}
	for name, b in pairs(binds) do
		data.Keybinds[name] = b.KeyCode and b.KeyCode.Name or false
	end
	for id, v in pairs(configValues) do
		data.Values[id] = v.Get()
	end
	local ok, err = pcall(function()
		local folder = CONFIG.ConfigFile:match("^(.*)/")
		if folder and typeof(makefolder) == "function"
			and not (typeof(isfolder) == "function" and isfolder(folder)) then
			makefolder(folder)
		end
		writefile(CONFIG.ConfigFile, HttpService:JSONEncode(data))
	end)
	if ok then
		if not silent then toast("CONFIG SAVED") end
	else
		warn("[WAVE HUB] save error: " .. tostring(err))
		if not silent then toast("COULDN'T SAVE CONFIG") end
	end
end

local function applyConfig(silent)
	if not hasFiles() then
		if not silent then toast("LOADING NEEDS AN EXECUTOR") end
		return
	end
	local ok, data = pcall(function()
		if not isfile(CONFIG.ConfigFile) then return nil end
		return HttpService:JSONDecode(readfile(CONFIG.ConfigFile))
	end)
	if not ok or type(data) ~= "table" then
		if not silent then toast(ok and "NO SAVED CONFIG" or "COULDN'T LOAD CONFIG") end
		return
	end

	if type(data.Notifications) == "boolean" and settingsRefresh.Notifications then
		settingsRefresh.Notifications(data.Notifications)
	end

	local mk = keyFromName(data.MenuKey)
	if mk and not GAMEPAD_KEYS[mk] then CONFIG.ToggleKey = mk end
	local mb = keyFromName(data.MenuButton)
	if mb and GAMEPAD_KEYS[mb] then CONFIG.ToggleKeyPad = mb end

	if type(data.Keybinds) == "table" then
		for name, keyNameSaved in pairs(data.Keybinds) do
			local b = binds[name]
			if b then
				b.KeyCode = keyFromName(keyNameSaved)
				if b.Refresh then b.Refresh() end
			end
		end
	end

	if type(data.Values) == "table" then
		for id, v in pairs(data.Values) do
			local cv = configValues[id]
			if cv and type(v) == "number" then pcall(cv.Set, v) end
		end
	end

	for _, refresh in ipairs(settingsRefresh.Menu) do refresh() end
	updateHideLabel()
	if not silent then toast("CONFIG LOADED") end
end

local function loadConfig(silent)
	loadingConfig = true
	local ok, err = pcall(applyConfig, silent)
	loadingConfig = false
	if not ok then warn("[WAVE HUB] load error: " .. tostring(err)) end
end

local DEFAULT_MENU_KEY = CONFIG.ToggleKey
local DEFAULT_MENU_BUTTON = CONFIG.ToggleKeyPad

local function resetConfig()
	loadingConfig = true
	pcall(function()
		if settingsRefresh.Notifications then settingsRefresh.Notifications(true) end
		CONFIG.ToggleKey = DEFAULT_MENU_KEY
		CONFIG.ToggleKeyPad = DEFAULT_MENU_BUTTON
		for name, b in pairs(binds) do
			b.KeyCode = CONFIG.DefaultKeybinds[name]
			if b.Refresh then b.Refresh() end
		end
		for _, cv in pairs(configValues) do
			if cv.Default ~= nil then pcall(cv.Set, cv.Default) end
		end
		for _, refresh in ipairs(settingsRefresh.Menu) do refresh() end
		updateHideLabel()
	end)
	loadingConfig = false
	saveConfig(true)
	toast("CONFIG RESET")
end

-- Settings Page
local function buildSettings()
	local page, body = newScrollPage("SETTINGS", "Hub preferences")
	local y, GAP = 80, 10

	local setNotifications = makeToggleRow(body, y, {
		Name = "NOTIFICATIONS",
		Hint = "SHOW POP-UPS WHEN SOMETHING CHANGES",
		Default = uiSettings.Notifications,
		OnChange = function(on) uiSettings.Notifications = on end,
	})
	settingsRefresh.Notifications = function(on) setNotifications(on, true) end
	y += 52 + GAP

	local function usedByTab(keyCode)
		for _, b in pairs(binds) do
			if b.KeyCode == keyCode then return true end
		end
		return false
	end

	table.insert(settingsRefresh.Menu, makeKeybindRow(body, y, {
		Title = "MENU KEY",
		Hint = "KEYBOARD",
		AllowClear = false,
		Get = function() return CONFIG.ToggleKey end,
		Set = function(keyCode)
			if not keyCode then return end
			CONFIG.ToggleKey = keyCode
			updateHideLabel()
			toast("MENU KEY SET TO " .. keyName(keyCode))
		end,
		Validate = function(keyCode)
			if GAMEPAD_KEYS[keyCode] then return false, "USE A KEYBOARD KEY HERE" end
			if usedByTab(keyCode) then return false, "THAT KEY IS USED BY A TAB" end
			return true
		end,
	}))
	y += 52 + GAP

	table.insert(settingsRefresh.Menu, makeKeybindRow(body, y, {
		Title = "MENU BUTTON",
		Hint = "CONTROLLER",
		AllowClear = false,
		Get = function() return CONFIG.ToggleKeyPad end,
		Set = function(keyCode)
			if not keyCode then return end
			CONFIG.ToggleKeyPad = keyCode
			updateHideLabel()
			toast("MENU BUTTON SET TO " .. keyName(keyCode))
		end,
		Validate = function(keyCode)
			if not GAMEPAD_KEYS[keyCode] then return false, "USE A CONTROLLER BUTTON HERE" end
			if usedByTab(keyCode) then return false, "THAT BUTTON IS USED BY A TAB" end
			return true
		end,
	}))
	y += 52 + GAP

	makeButtonRow(body, y, {
		Name = "CLEAR KEYBINDS",
		Hint = "REMOVES EVERY KEYBIND",
		ButtonText = "CLEAR",
		OnClick = function()
			for _, b in pairs(binds) do
				b.KeyCode = nil
				if b.Refresh then b.Refresh() end
			end
			toast("ALL KEYBINDS UNBOUND")
		end,
	})
	y += 52 + GAP

	makeButtonRow(body, y, {
		Name = "SAVE CONFIG",
		Hint = "SAVES KEYBINDS AND SETTINGS",
		ButtonText = "SAVE",
		OnClick = function() saveConfig(false) end,
	})
	y += 52 + GAP

	makeButtonRow(body, y, {
		Name = "LOAD CONFIG",
		Hint = "LOADS SAVED CONFIG",
		ButtonText = "LOAD",
		OnClick = function() loadConfig(false) end,
	})
	y += 52 + GAP

	makeButtonRow(body, y, {
		Name = "RESET CONFIG",
		Hint = "PUTS EVERYTHING BACK TO DEFAULT",
		ButtonText = "RESET",
		OnClick = resetConfig,
	})
	y += 52 + GAP

	body.CanvasSize = UDim2.fromOffset(0, y)
	return page
end

-- Feature Pages
local function buildFeature(name, feature)
	local page = newPage(name)

	local body = create("ScrollingFrame", {
		Name = "Body",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 3,
		ScrollBarImageColor3 = THEME.Accent,
		ScrollingDirection = Enum.ScrollingDirection.Y,
		CanvasSize = UDim2.new(),
		ZIndex = 5,
		Parent = page,
	}, {
		create("UIPadding", { PaddingRight = UDim.new(0, 8) }),
	})

	pageHeader(body, name, feature.Description)
	local y = 80
	local GAP = 10

	local card = create("TextLabel", {
		Position = UDim2.fromOffset(0, y),
		Size = UDim2.new(1, 0, 0, 58),
		BackgroundColor3 = THEME.Card,
		BackgroundTransparency = 0,
		Text = "",
		ZIndex = 5,
		Parent = body,
	}, { corner(UDim.new(0, 11)) })
	local cardStroke = stroke(THEME.Accent, 1, 0.75)
	cardStroke.Parent = card
	y += 58 + GAP

	create("TextLabel", {
		Position = UDim2.fromOffset(16, 9),
		Size = UDim2.new(1, -100, 0, 20),
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamBold,
		Text = "ENABLE " .. name,
		TextColor3 = THEME.Text,
		TextSize = 14,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
		ZIndex = 6,
		Parent = card,
	})
	local status = create("TextLabel", {
		Position = UDim2.fromOffset(16, 30),
		Size = UDim2.new(1, -100, 0, 16),
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamMedium,
		Text = "STATUS: OFF",
		TextColor3 = THEME.SubText,
		TextSize = 11,
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 6,
		Parent = card,
	})

	local switch = create("Frame", {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -16, 0.5, 0),
		Size = UDim2.fromOffset(48, 24),
		BackgroundColor3 = THEME.Off,
		ZIndex = 6,
		Parent = card,
	}, { corner(UDim.new(1, 0)) })
	local knob = create("Frame", {
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 3, 0.5, 0),
		Size = UDim2.fromOffset(18, 18),
		BackgroundColor3 = THEME.Foam,
		ZIndex = 7,
		Parent = switch,
	}, { corner(UDim.new(1, 0)) })

	local enabled = false

	card.MouseEnter:Connect(function()
		tween(card, TI_FAST, { BackgroundColor3 = THEME.CardHover })
		tween(cardStroke, TI_FAST, { Transparency = 0.4 })
	end)
	card.MouseLeave:Connect(function()
		tween(card, TI_FAST, { BackgroundColor3 = THEME.Card })
		tween(cardStroke, TI_FAST, { Transparency = enabled and 0.3 or 0.75 })
	end)

	local function toggleFeature()
		if destroyed then return end
		enabled = not enabled
		featureStates[name] = enabled or nil

		tween(switch, TI_MED, { BackgroundColor3 = enabled and THEME.Accent or THEME.Off })
		tween(knob, TI_MED, { Position = enabled and UDim2.new(1, -21, 0.5, 0) or UDim2.new(0, 3, 0.5, 0) })
		tween(cardStroke, TI_MED, { Transparency = enabled and 0.3 or 0.75 })
		status.Text = enabled and "STATUS: ON" or "STATUS: OFF"
		tween(status, TI_MED, { TextColor3 = enabled and THEME.Aqua or THEME.SubText })

		local fn = enabled and feature.Enable or feature.Disable
		local ok, err = pcall(fn)
		if not ok then
			warn("[WAVE HUB] " .. name .. " error: " .. tostring(err))
		end
		toast(name .. (enabled and " ENABLED" or " DISABLED"))

	end
	onClick(card, toggleFeature)

	local bind = { KeyCode = CONFIG.DefaultKeybinds[name], Toggle = toggleFeature }
	binds[name] = bind
	bind.Refresh = makeKeybindRow(body, y, {
		Title = "KEYBIND",
		Hint = "KEYBOARD  OR  CONTROLLER",
		AllowClear = true,
		Get = function() return bind.KeyCode end,
		Set = function(keyCode)
			bind.KeyCode = keyCode
			if keyCode then
				toast(name .. " BOUND TO " .. keyName(keyCode))
			else
				toast(name .. " UNBOUND")
			end
		end,
		Validate = function(keyCode)
			if keyCode == CONFIG.ToggleKey or keyCode == CONFIG.ToggleKeyPad then
				return false, "THAT KEY OPENS THE MENU"
			end
			return true
		end,
	})
	y += 52 + GAP

	for _, def in ipairs(feature.Sliders or {}) do
		local set, get = makeSlider(body, y, def)
		configValues[name .. "/" .. def.Name] = { Get = get, Set = function(v) set(v, true) end, Default = def.Default }
		y += 62 + GAP
	end

	for _, def in ipairs(feature.Inputs or {}) do
		local set, get = makeNumberInput(body, y, def)
		configValues[name .. "/" .. def.Name] = { Get = get, Set = set, Default = def.Default }
		y += 52 + GAP
	end

	body.CanvasSize = UDim2.fromOffset(0, y)
	return page
end

-- Tabs
local tabs = {}
local currentTab = nil

local function selectTab(name)
	if currentTab == name then return end
	local old = currentTab and tabs[currentTab]
	local new = tabs[name]
	currentTab = name

	tween(indicator, TI_MED, { Position = UDim2.fromOffset(10, new.Y) })
	indicatorBar.Size = UDim2.fromOffset(3, 6)
	tween(indicatorBar, TI_SLOW, { Size = UDim2.fromOffset(3, 18) })

	for tabName, data in pairs(tabs) do
		tween(data.Button, TI_FAST, {
			TextColor3 = (tabName == name) and THEME.Text or THEME.SubText,
		})
	end

	if old then
		local oldPage, oldName = old.Page, old.Name
		tween(oldPage, TI_FAST, { GroupTransparency = 1, Position = UDim2.fromOffset(-12, 0) })
		task.delay(0.2, function()
			if currentTab ~= oldName then oldPage.Visible = false end
		end)
	end

	local page = new.Page
	page.Visible = true
	page.GroupTransparency = 1
	page.Position = UDim2.fromOffset(16, 0)
	tween(page, TI_MED, { GroupTransparency = 0, Position = UDim2.fromOffset(0, 0) })
end

for i, name in ipairs(TAB_ORDER) do
	local y = 12 + (i - 1) * (TAB_H + TAB_GAP)
	local button = create("TextLabel", {
		Position = UDim2.fromOffset(10, y),
		Size = UDim2.new(1, -20, 0, TAB_H),
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamBold,
		Text = name,
		TextColor3 = THEME.SubText,
		TextSize = 12,
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 7,
		Parent = sidebar,
	}, {
		create("UIPadding", { PaddingLeft = UDim.new(0, 18) }),
	})

	local page
	if name == "HOME" then
		page = buildHome()
	elseif name == "SETTINGS" then
		page = buildSettings()
	else
		page = buildFeature(name, Features[name])
	end
	tabs[name] = { Name = name, Button = button, Page = page, Y = y }

	button.MouseEnter:Connect(function()
		if currentTab ~= name then tween(button, TI_FAST, { TextColor3 = THEME.Accent }) end
	end)
	button.MouseLeave:Connect(function()
		if currentTab ~= name then tween(button, TI_FAST, { TextColor3 = THEME.SubText }) end
	end)
	onClick(button, function()
		selectTab(name)
	end)
end

-- Smooth Dragging
local targetPos = UDim2.fromScale(0.5, 0.5)
local dragging, dragStart, startPos, dragInput = false, nil, nil, nil

topBar.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		dragging = true
		dragInput = input
		dragStart = input.Position
		startPos = targetPos
		input.Changed:Connect(function()
			if input.UserInputState == Enum.UserInputState.End then
				dragging = false
				dragInput = nil
			end
		end)
	end
end)

table.insert(connections, UserInputService.InputChanged:Connect(function(input)
	if not dragging or not dragInput then return end

	local isMouseMove = dragInput.UserInputType == Enum.UserInputType.MouseButton1
		and input.UserInputType == Enum.UserInputType.MouseMovement
	if isMouseMove or input == dragInput then
		local delta = input.Position - dragStart
		targetPos = UDim2.new(
			startPos.X.Scale, startPos.X.Offset + delta.X,
			startPos.Y.Scale, startPos.Y.Offset + delta.Y
		)
	end
end))

table.insert(connections, RunService.RenderStepped:Connect(function(dt)
	local alpha = 1 - math.exp(-dt * 16)
	holder.Position = holder.Position:Lerp(targetPos, alpha)
end))

-- Show / Hide
local visTweens = {}
local function cancelVisTweens()
	for _, t in ipairs(visTweens) do t:Cancel() end
	table.clear(visTweens)
end

local function show()
	hubVisible = true
	cancelVisTweens()
	holder.Visible = true
	table.insert(visTweens, tween(main, TI_SLOW, { GroupTransparency = 0 }))
	table.insert(visTweens, tween(uiScale, TweenInfo.new(0.55, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = UI_SIZE }))
end

local function hide()
	hubVisible = false
	cancelVisTweens()
	local info = TweenInfo.new(0.35, Enum.EasingStyle.Quint, Enum.EasingDirection.In)
	local t = tween(main, info, { GroupTransparency = 1 })
	table.insert(visTweens, t)
	table.insert(visTweens, tween(uiScale, info, { Scale = UI_SIZE * 0.9 }))
	t.Completed:Connect(function(state)
		if state == Enum.PlaybackState.Completed and not hubVisible then
			holder.Visible = false
		end
	end)
end

table.insert(connections, UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if destroyed then return end

	local isKeyboard = input.UserInputType == Enum.UserInputType.Keyboard
	local isGamepad = GAMEPAD_TYPES[input.UserInputType] and GAMEPAD_KEYS[input.KeyCode]

	if listening then
		local keyCode
		if isKeyboard then
			if input.KeyCode == Enum.KeyCode.Escape then
				listening.Cancel()
				return
			elseif input.KeyCode == Enum.KeyCode.Backspace then
				if listening.AllowClear then listening.Capture(nil) end
				return
			elseif input.KeyCode ~= Enum.KeyCode.Unknown then
				keyCode = input.KeyCode
			end
		elseif isGamepad then
			keyCode = input.KeyCode
		end
		if keyCode then
			local ok, msg = listening.Validate(keyCode)
			if ok then
				listening.Capture(keyCode)
			else
				toast(msg or "CAN'T USE THAT KEY")
			end
		end
		return
	end

	if isKeyboard and gameProcessed then return end

	if (isKeyboard and input.KeyCode == CONFIG.ToggleKey)
		or (isGamepad and input.KeyCode == CONFIG.ToggleKeyPad) then
		if hubVisible then hide() else show() end
		return
	end

	if isKeyboard or isGamepad then
		for _, bind in pairs(binds) do
			if bind.KeyCode == input.KeyCode then
				bind.Toggle()
			end
		end
	end
end))

-- Destroy
local function destroyHub()
	if destroyed then return end
	destroyed = true
	hubVisible = false

	for name in pairs(featureStates) do
		local ok, err = pcall(Features[name].Disable)
		if not ok then
			warn("[WAVE HUB] " .. name .. " cleanup error: " .. tostring(err))
		end
	end
	table.clear(featureStates)

	cancelVisTweens()
	local info = TweenInfo.new(0.3, Enum.EasingStyle.Quint, Enum.EasingDirection.In)
	tween(main, info, { GroupTransparency = 1 })
	tween(uiScale, info, { Scale = UI_SIZE * 0.85 })
	task.wait(0.32)

	for _, c in ipairs(connections) do c:Disconnect() end
	table.clear(connections)
	screenGui:Destroy()
	script:Destroy()
end

